# Variables del panel Keystatic en modo GitHub (npm run dev:panel, npm run build:panel).
# Copie este archivo a .env para trabajar en local y nunca suba valores reales al repositorio.
# En producción van como variables o secretos del hosting. Ver docs/ACCESOS.md.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=